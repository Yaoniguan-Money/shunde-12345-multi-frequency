SHUNDE_ENVIRONMENT=development
SHUNDE_DATABASE_URL=postgresql+asyncpg://shunde:shunde@127.0.0.1:5432/shunde
SHUNDE_POSTGRES_IMAGE=m.daocloud.io/docker.io/pgvector/pgvector:0.8.1-pg17
SHUNDE_GAZETTEER_API_BASE_URL=http://127.0.0.1:8000
# Configure only when a real local model server is running.
# Ollama exposes OpenAI-compatible chat at /v1 and native embeddings at /api/embed.
# SHUNDE_MODEL_API_BASE_URL=http://127.0.0.1:11434
# SHUNDE_LLM_MODEL_ID=qwen2.5:3b
# SHUNDE_EMBEDDING_API_BASE_URL=http://127.0.0.1:11434
# SHUNDE_EMBEDDING_MODEL_ID=nomic-embed-text
# Provider selection is explicit. This example is the reviewed cloud-first Demo Core profile;
# Settings remains local when the variable is absent.
SHUNDE_AI_PROVIDER_MODE=remote
# Optional explicit local overrides (legacy model_* fields above remain supported).
# SHUNDE_AI_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# SHUNDE_AI_LOCAL_LLM_MODEL_ID=qwen2.5:3b
# SHUNDE_AI_LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# SHUNDE_AI_LOCAL_EMBEDDING_MODEL_ID=nomic-embed-text
# SHUNDE_AI_LOCAL_EMBEDDING_PROTOCOL=ollama
# Remote is never inferred and has no automatic fallback. Use an environment secret only.
# Qwen/DashScope OpenAI-compatible example (explicit remote only):
# SHUNDE_AI_REMOTE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SHUNDE_AI_REMOTE_LLM_MODEL_ID=qwen-plus
# SHUNDE_AI_REMOTE_EMBEDDING_MODEL_ID=qwen3.7-text-embedding
# SHUNDE_AI_REMOTE_API_KEY=replace-in-your-process-environment
SHUNDE_AI_HYBRID_POLICY=explicit-route-local-default
SHUNDE_MODEL_TIMEOUT_SECONDS=120.0
SHUNDE_MODEL_CONCURRENCY=1
SHUNDE_ANALYSIS_PIPELINE_VERSION=understanding.v2
SHUNDE_ANALYSIS_SCHEMA_VERSION=understanding.v2
SHUNDE_DEPENDENCY_TIMEOUT_SECONDS=2.0
SHUNDE_GAZETTEER_HOME=C:\Users\Lenovo\Desktop\顺德地名库交接包
SHUNDE_GAZETTEER_SNAPSHOT_PATH=./data/runtime/gazetteer.snapshot.json
VITE_API_BASE_URL=http://127.0.0.1:8080
